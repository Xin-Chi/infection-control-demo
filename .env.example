# Copy to .env and adjust.  .env is git-ignored and must never be committed.

# Public showcase build: the 查詢 page is readable without an account,
# navigation is trimmed to that page, and every write is refused.
# Set to 0 for the full application (login required, all sections available).
DJANGO_DEMO_MODE=1

# Required whenever DJANGO_DEBUG is off.  Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Never leave this on outside local development.
DJANGO_DEBUG=1

# Comma-separated.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Only needed when serving over HTTPS behind a proxy, e.g.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://demo.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Defaults to db.sqlite3 next to manage.py.
DJANGO_DB_PATH=

DJANGO_LOG_LEVEL=INFO
